{
  "name": "breakbeat",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Breakbeat \u2014 you choose what breaks; the music chooses when.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && node tools/serve.mjs",
    "start": "node tools/serve.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "gates": "npm run check && npm test && node tools/gates.mjs && node tools/check-balance.mjs && npm run verify:deploy",
    "verify:deploy": "node tools/verify-deploy.mjs",
    "balance:report": "npm run build && node tools/balance-report.mjs 40 42"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
